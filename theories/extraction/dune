(subdir
 stage
 (rule
  (target source-commit.txt)
  (deps
   (env_var QASMINFER_SOURCE_COMMIT)
   (glob_files ../../extracted.ml)
   (:source_commit_resolver ../resolve_source_commit.sh))
  (action
   (with-stdout-to
    source-commit.txt
    (run %{source_commit_resolver} ../../extracted.ml))))

 (rule
  (target extracted.ml)
  (deps
   source-commit.txt
   (glob_files_rec ../../*.{vo,vos})
   ../../extract/Extract.v
   ../../program/Program.vo
   ../../matrix/Complex.vo
   ../../rewrite/All.vo
   ../../transform/Flatten.vo
   ../../domega/All.vo
   (:dune_project ../../dune-project)
   (:header_txt ../../extract/extraction_header.txt)
   (:patcher ../patch_extraction.sh))
  (action
   (progn
    (run
     %{bin:rocq}
     repl
     -q
     -Q
     ../..
     QASMInfer
     -batch
     -l
    ../../extract/Extract)
    (setenv
     QASMINFER_SOURCE_COMMIT
     %{read:source-commit.txt}
     (setenv
      QASMINFER_ROCQ_VERSION
      %{rocq:version}
      (setenv
       QASMINFER_DUNE_ROCQ_LANGUAGE_VERSION
       0.14
       (setenv
        QASMINFER_EXTRACTION_COMMAND
        "rocq repl -q -Q ../.. QASMInfer -batch -l ../../extract/Extract"
        (setenv
         QASMINFER_DUNE_PROJECT
         %{dune_project}
         (run %{patcher} %{header_txt} extracted.ml))))))))))

(rule
 (alias extract)
 (deps
  (:generated stage/extracted.ml))
 (action
  (diff ../extracted.ml %{generated})))

(rule
 (alias check-extraction)
 (deps
  (:generated stage/extracted.ml))
 (action
  (progn
   (bash
    "if ! cmp -s ../extracted.ml %{generated}; then
       echo 'Committed theories/extracted.ml is stale; run dune build --root theories @extract --auto-promote and commit the result.' >&2
     fi")
   (diff ../extracted.ml %{generated}))))
