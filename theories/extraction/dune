(subdir
 stage
 (rule
  (target extracted.ml)
  (deps
   (sandbox none)
   (glob_files_rec ../../*.{vo,vos})
   ../../extract/Extract.v
   ../../program/Program.vo
   ../../matrix/Complex.vo
   ../../rewrite/All.vo
   ../../transform/Flatten.vo
   ../../domega/All.vo
   (source_tree ../..)
   (:patcher ../../../scripts/patch_extraction.sh)
   (:header_txt ../../extract/extraction_header.txt))
  (action
   (progn
    (run
     %{bin:rocq}
     repl
     -q
     -Q
     ../..
     QASMInfer
     -batch
     -l
     ../../extract/Extract)
    (setenv
     QASMINFER_ROCQ_VERSION
     %{rocq:version}
     (setenv
      QASMINFER_DUNE_ROCQ_LANGUAGE_VERSION
      0.14
      (setenv
       QASMINFER_EXTRACTION_COMMAND
       "rocq repl -q -Q ../.. QASMInfer -batch -l ../../extract/Extract"
       (run %{patcher} %{header_txt} extracted.ml))))))))

(rule
 (alias extract)
 (deps
  (:committed ../extracted.ml)
  (:generated stage/extracted.ml))
 (action
  (diff %{committed} %{generated})))

(rule
 (alias check-extraction)
 (deps
  (:committed ../extracted.ml)
  (:generated stage/extracted.ml))
 (action
  (progn
   (bash
    "if ! cmp -s %{committed} %{generated}; then
       echo 'Committed theories/extracted.ml is stale; run dune build --root theories @extract --auto-promote and commit the result.' >&2
     fi")
   (diff %{committed} %{generated}))))
